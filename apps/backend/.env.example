# ── General ────────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
#LOG_FILE=logs/alga.log
# Log output format: "text" (human-readable) or "json" (structured, for production)
# LOG_FORMAT=text

# ── Environment ────────────────────────────────────────────────────────────────
# Set to "production" to enforce production-only checks (secure cookies). Crypto
# config (ENCRYPTION_KEYS / SECRET_PEPPER) is required in ALL environments
# (ASVS V2.1/V6.2).
ENVIRONMENT=

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# On first boot (no users in the database), the UI redirects to a setup wizard
# at /setup where you create the initial admin account (email + password).
# No env var is required and no password is auto-generated or printed to stdout.
# After the wizard creates the admin, onboarding guides the first login.

# ── Session & cookies ─────────────────────────────────────────────────────────
# SESSION_EXPIRY_HOURS is the sliding (idle) session expiry.
# SESSION_MAX_LIFETIME is the absolute (max) session lifetime, enforced in
# addition to the idle expiry (ASVS V3.2/V3.3): a session is rejected once it
# is older than this even if refreshed recently. Default: 12h.
SESSION_EXPIRY_HOURS=24
SESSION_MAX_LIFETIME=12h
SECURE_COOKIES=false

# ── HTTP server hardening (ASVS V12.1) ────────────────────────────────────────
# All have safe defaults; override only to tune for your deployment.
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_IDLE_TIMEOUT=120s
# SERVER_MAX_HEADER_BYTES=1048576

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# DEVELOPMENT may use sslmode=disable for a local DB. PRODUCTION must use
# sslmode=require (or verify-full) — never deploy with sslmode=disable against
# a remote/production database (ASVS V9.1, SPEC gap L2).
POSTGRES_DSN=postgres://alga:alga_dev_only@localhost:5432/alga?sslmode=disable
POSTGRES_AUTO_MIGRATE=false
# Connection pool tuning. Blank/omitted values use built-in production defaults
# (max_open=25, max_idle=5, conn_max_idle_time=5m, conn_max_lifetime=30m).
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_CONN_MAX_LIFETIME=30m

# ── Cryptography (REQUIRED in production) ──────────────────────────────────────
#
# ENCRYPTION_KEYS is a comma-separated list of `kid:base64(32-byte key)` pairs.
# The highest kid is used to seal new ciphertexts; lower kids are kept so
# historical ciphertexts still decrypt.
#
#   ENCRYPTION_KEYS=1:<base64-32B>,2:<base64-32B>
#
# SECRET_PEPPER is a server-side HMAC pepper applied to passwords (pre-Argon2)
# and to bearer/session tokens (HMAC lookups). Required for any HMAC use.
#
# Generate values with: openssl rand -base64 32
ENCRYPTION_KEYS=
SECRET_PEPPER=

# ── Argon2id tuning (optional) ────────────────────────────────────────────────
#
# Defaults follow OWASP 2026 (m=64MiB, t=3, p=2). Tune so a single hash
# takes ~250–500ms on production hardware. Memory is the dominant cost;
# combined with MAX_CONCURRENT_PASSWORD_HASHES it bounds API memory at
# roughly ARGON2_MEMORY_KIB * MAX_CONCURRENT_PASSWORD_HASHES KiB.
ARGON2_MEMORY_KIB=
ARGON2_TIME=
ARGON2_PARALLELISM=
ARGON2_SALT_LEN=
ARGON2_KEY_LEN=
MAX_CONCURRENT_PASSWORD_HASHES=

# ── Trusted proxies (optional) ────────────────────────────────────────────────
# Comma-separated list of trusted proxy IPs/CIDRs for rate limiting and
# client-IP extraction.
TRUSTED_PROXIES=

# ── Slack Integration (optional) ──────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
SLACK_DISABLED=false
SLACK_SIGNING_SECRET=
# OAuth flow (enables "Add to Slack" button)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URL=

# ── Mattermost Integration (optional) ─────────────────────────────────────────
# Set the server URL and shared secret. No Mattermost bot token on the Alga side.
MATTERMOST_SERVER_URL=
MATTERMOST_WEBHOOK_SECRET=
MATTERMOST_TEAM=
MATTERMOST_DEFAULT_CHANNEL=
MATTERMOST_DISABLED=false

# ── RabbitMQ (optional) ──────────────────────────────────────────────────────
# Enables async alert/investigation pipeline with retry topology.
RABBITMQ_URI=

# ── Valkey (optional) ────────────────────────────────────────────────────────
# Enables Valkey-backed sessions, caching, rate limiting, presence, leader election.
VALKEY_ADDR=
VALKEY_PASSWORD=
VALKEY_DB=0

# ── Idempotency-Key replay (optional; requires Valkey) ────────────────────────
# Enables safe client retries for high-value, retry-safe writes (create
# incident, ingest alert webhook, notification send, agent state-changing
# actions). When a client sends an `Idempotency-Key` request header, the first
# successful (2xx) response is cached in Valkey and replayed for later requests
# with the same key until IDEMPOTENCY_TTL expires. Requests without the header,
# and every non-opted-in route, are unaffected. No-op when Valkey is not set.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=24h

# Retention window for the transactional outbox: published rows are pruned once
# they are older than this so the outbox table stays bounded. Set to 0 to
# disable pruning. The outbox worker also keeps terminal-failed rows for
# operator inspection.
ALGA_OUTBOX_RETENTION=168h

# Data-retention sweeper (hourly, leader-elected): prunes resolved alerts,
# triage results, and notification delivery logs older than
# DATA_RETENTION_DAYS (0 keeps them forever), and audit logs older than
# AUDIT_RETENTION_DAYS (below; 0 keeps them forever). Consumed/expired
# password-reset tokens are always swept once they are a week past expiry.
AUDIT_RETENTION_DAYS=365

# ── Hermes / SRE agent (optional) ────────────────────────────────────────────
HERMES_PLATFORM_URL=
HERMES_PLATFORM_TOKEN=

# ── Legacy query-token auth (optional escape hatches, deny by default) ───────
# Credentials in URLs leak via proxy/access logs, Referer headers and browser
# history. Both flags below re-enable the legacy `?token=` authentication and
# are slated for removal one minor release after introduction. A loud warning
# is logged at startup when either is true.
# WEBHOOK_ALLOW_QUERY_TOKEN=true accepts ?token= on POST /webhooks/alerts
#   (Grafana/Alertmanager senders should migrate to the Authorization header).
WEBHOOK_ALLOW_QUERY_TOKEN=false
# AGENT_SSE_ALLOW_QUERY_TOKEN=true accepts ?token= on GET /api/v1/agent/events
#   for pure-EventSource consumers; prefer fetch()-based SSE with a Bearer
#   header (all bundled SDKs already use headers).
AGENT_SSE_ALLOW_QUERY_TOKEN=false

# ── Agent SSE (optional) ──────────────────────────────────────────────────────
# Comma-separated Origin allowlist for the agent SSE endpoint.
AGENT_SSE_ALLOWED_ORIGINS=

# ── Alert correlation (optional) ──────────────────────────────────────────────
# Alerts that share a correlation key within CORRELATION_WINDOW are merged into
# one investigation. Set to 0 or leave empty to disable.
CORRELATION_WINDOW=0
CORRELATION_COOLDOWN_TTL=30m

# ── Investigation (optional) ──────────────────────────────────────────────────
INVESTIGATION_TIMEOUT=10m
MAX_CONCURRENT_INVESTIGATIONS=3

# ── Scheduler HA (optional) ──────────────────────────────────────────────────
# TTL on the Valkey-backed scheduler leader lease. Set to 0 for single-replica.
SCHEDULER_LEADER_TTL=15s
AGENT_PRESENCE_TTL=90s
AGENT_DISCONNECT_GRACE=45s

# ── Stale Alert Sweep (optional) ─────────────────────────────────────────────
# When the scheduler detects firing alerts that have no associated investigation
# (e.g. they arrived before the correlator was enabled, or the pipeline was
# down), it automatically publishes investigation jobs for them.
#
# STALE_ALERT_THRESHOLD is the minimum age a firing alert must reach before it
# is considered stale. Set to 0 or leave empty to disable. Default: 15m.
#
# STALE_ALERT_SWEEP_INTERVAL is how often the scheduler scans for stale alerts.
# Default: 5m.
STALE_ALERT_THRESHOLD=15m
STALE_ALERT_SWEEP_INTERVAL=5m

# ── SLA sweep (scheduler-owned, DT-E1) ───────────────────────────────────────
# SLA_SWEEP_INTERVAL is how often the scheduler leader publishes an SLA sweep
# request tick to RabbitMQ, driving SLA breach detection (timeline entries,
# SSE alerts, and breach escalations for past-due incidents). Set to 0 to
# disable publication entirely. Default: 60s.
SLA_SWEEP_INTERVAL=60s

# ── Twilio voice escalation (optional) ───────────────────────────────────────
# Credentials are managed in the DB via the Integrations UI (stored encrypted),
# the same model as Slack/Mattermost. These env vars act as a bootstrap fallback
# / override: when TWILIO_ACCOUNT_SID is set, the UI fields are locked and the
# env values take precedence.
# Escalation pages each on-call user's phone (user.phone, E.164) — not a global
# recipient list.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set to true to disable Twilio entirely (also togglable from the Integrations UI).
TWILIO_DISABLED=false

# ── Telnyx voice escalation (optional) ──────────────────────────────────────
# Voice provider selection: "twilio" (default) or "telnyx". Twilio and Telnyx
# are mutually exclusive — only the selected provider is constructed, has its
# callback route live, and can be enabled; the other is fully dormant.
# When this env var is unset, the provider can be chosen from the Integrations
# UI (persisted in the DB). Setting VOICE_PROVIDER locks the UI selector.
# Either way, switching providers requires a restart to take effect.
VOICE_PROVIDER=twilio
# When TELNYX_API_KEY is set via env, the Integrations UI fields are locked.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Ed25519 public key (base64) from the Telnyx portal, used to verify inbound
# call-control webhooks at /api/v1/telnyx/callback. Required when VOICE_PROVIDER=telnyx.
TELNYX_PUBLIC_KEY=
TELNYX_DISABLED=false
# TTS voice for spoken prompts on Telnyx escalation calls. The provider is
# encoded in the voice prefix (e.g. "Polly.Brian", "Azure.en-CA-ClaraNeural",
# "ElevenLabs.eleven_flash_v2_5.<voice_id>"). Defaults to a free Telnyx voice.
TELNYX_TTS_VOICE=
TELNYX_TTS_LANGUAGE=
# Identifier of a Telnyx integration secret holding the ElevenLabs API key.
# Required only when TELNYX_TTS_VOICE starts with "ElevenLabs."; otherwise
# ignored. Register the secret out-of-band via POST /v2/integration_secrets.
TELNYX_TTS_API_KEY_REF=

# ── Escalation routing (optional) ──────────────────────────────────────────
INVESTIGATION_CHANNEL=
CRITICAL_SEVERITY_LABELS=

# ── Config file (optional) ───────────────────────────────────────────────────
# Optional YAML for non-route settings (routes live in PostgreSQL).
CONFIG_PATH=./config/config.yaml

# ── Agent Memory (optional) ──────────────────────────────────────────────────
# Shared agent memory system for extracting and searching investigation memories.
MEMORY_ENABLED=false
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=
MEMORY_LLM_URL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=
MEMORY_AUTO_EXTRACT=false
MEMORY_MAX_PER_INVESTIGATION=
MEMORY_SIMILARITY_THRESHOLD=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Required for password reset. If SMTP_HOST is empty, password reset emails are
# logged but not delivered.
# SMTP_SKIP_TLS_VERIFY disables TLS certificate verification for outgoing email.
# Defaults to false. Enabling it is an MITM risk and logs a loud warning on
# startup (ASVS V9.2, SPEC gap L6).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SKIP_TLS_VERIFY=false

# Google OAuth (enables "Sign in with Google" on login page)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_OAUTH_REDIRECT_URL=
#GOOGLE_OAUTH_ENABLED=true

# Google Meet war room (auto-creates a Meet space per incident).
# Requires a service-account JSON with the Meet API enabled and domain-wide
# delegation granted for scope: https://www.googleapis.com/auth/meet.space.admin
#GOOGLE_MEET_ENABLED=true
#GOOGLE_MEET_CREDENTIALS_PATH=/etc/alga/google-meet-service-account.json
#GOOGLE_MEET_AUTO_CREATE=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-minute fixed-window ceilings, applied identically by the memory and
# Valkey limiter backends. Raise GENERAL if a legitimate source (e.g. a busy
# Grafana) posts more than 20 webhook requests per minute from one IP.
RATE_LIMIT_GENERAL_PER_MINUTE=20
RATE_LIMIT_AGENT_PER_MINUTE=120
