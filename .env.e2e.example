# LLM credentials for the alga-agent full-stack E2E test.
# Copy to a git-ignored working file and fill in your key:
#   cp .env.e2e.example .env.e2e && chmod 600 .env.e2e
# Then run:
#   source .env.e2e && cd apps/alga-agent && ALGA_AGENT_E2E=1 go test ./e2e/... -v -timeout 10m -count=1

# OpenCode Zen (OpenAI-compatible endpoint; default):
export OPENAI_API_KEY=
export OPENAI_BASE_URL=https://opencode.ai/zen/v1

# Alternative: OpenRouter (remove OPENAI_BASE_URL above, set this instead)
#export OPENROUTER_API_KEY=

# Model ID (for Zen see https://opencode.ai/zen; pick a capable model — weak free models flake).
export OPENAI_MODEL=

# Optional overrides:
#export ALGA_E2E_SERVER_URL=http://localhost:3100
#export ALGA_E2E_ADMIN_PASSWORD=E2eAdmin!12345
#export ALGA_AGENT_E2E_TOOLS=1
