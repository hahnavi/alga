{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Replaces .github/dependabot.yml (removed in the same change). Renovate
  // auto-discovers every go.mod, package.json, Dockerfile, and Chart.yaml in
  // the monorepo, so a single config covers all dependency surfaces. The old
  // Dependabot config only managed three: workflow actions, apps/backend
  // go.mod, and apps/frontend package.json — it silently ignored the agent and
  // integration modules, the root/docs npm workspaces, Dockerfile base images,
  // and the Helm chart.
  "extends": [
    "config:recommended",   // base managers + sensible defaults
    ":semanticCommits",     // conventional-commit PR titles (deps(go): ...)
    ":dependencyDashboard", // tracking issue listing pending updates
    "workarounds:all"       // upstream quirks the recommended preset misses
  ],

  // Vulnerability PRs bypass the schedule; routine updates batch weekly to
  // match the old Dependabot cadence and keep PR noise low.
  "timezone": "UTC",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies"],

  // ── Supply-chain cooldown: wait for releases to age before opening PRs ──
  // Renovate won't create a branch for an update until the release is older
  // than 1 day. With internalChecksFilter=strict, too-new versions land in
  // "Pending Status Checks" on the dependency dashboard instead of opening a
  // branch whose lockfile would then fail `pnpm install --frozen-lockfile`
  // in CI (ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION). This mirrors the pnpm
  // minimumReleaseAge policy (1440m) enforced at install time; Renovate
  // cannot read pnpm's value, so the two must be kept in sync manually —
  // see pnpm-workspace.yaml. Vulnerability PRs bypass this and arrive
  // immediately. Applies to all managers (npm, gomod, dockerfile, helm, etc).
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",

  "packageRules": [
    // ── Commit-message scopes mirror the old Dependabot prefixes ───────
    // semanticCommits renders "<type>(<scope>): <subject>", e.g.
    //   chore(ci):  bump actions/checkout from … to …
    //   deps(go):   bump github.com/redis/go-redis from 9.1 to 9.2
    //   deps(npm):  bump vue from 3.5.0 to 3.5.4
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": ["gomod"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "go"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "npm"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "docker"
    },
    {
      "matchManagers": ["helmv3", "helm-values"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "helm"
    },

    // ── Group minor + patch; major versions stay as single PRs ─────────
    // One reviewable PR per ecosystem instead of one per dependency.
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules (minor/patch)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dependencies (minor/patch)"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions"
    },

    // ── Frozen: Go toolchain version ───────────────────────────────────
    // Never bump the `go` / `toolchain` directive in go.mod. CI pins
    // GO_VERSION="1.27.0" with GOTOOLCHAIN=local (see ci.yml): a directive
    // above the pinned runner toolchain makes every build fail loudly instead
    // of auto-downloading. The version is managed manually alongside the CI
    // pin — Renovate's github-actions manager cannot see that env var.
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "enabled": false
    },

    // ── Frozen: pnpm / packageManager version ──────────────────────────
    // pnpm is pinned in THREE places that must stay in lockstep:
    //   1. root package.json          "packageManager": "pnpm@12.0.0"
    //   2. apps/frontend/Dockerfile   npm install -g pnpm@12.0.0
    //   3. .github/workflows/ci.yml   env PNPM_VERSION: "12.0.0"
    // Renovate can update (1) and (2) but not the CI env (3), and CI is
    // intentionally decoupled from the packageManager field (ci.yml passes
    // PNPM_VERSION to pnpm/setup explicitly so it never falls back to
    // packageManager). A partial bump — e.g. packageManager→12.0.1 while CI
    // stays at 12.0.0 — silently splits the toolchain between CI and dev
    // machines. pnpm stays a deliberate, manual pin across all three.
    {
      "matchPackageNames": ["pnpm"],
      "enabled": false
    }
  ]
}
