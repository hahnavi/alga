{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "E2E_INTEGRATION=1 playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.74.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~7.0.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.7"
  }
}
