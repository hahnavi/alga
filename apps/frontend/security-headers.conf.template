# Alga SPA / static-asset security headers.
#
# Scoped to the nginx locations that serve first-party HTML/JS/CSS only
# (location /, /assets/, = /index.html). The /api/, /api/v1/events and
# /webhooks/ proxy locations intentionally do NOT include this file: those
# responses are hardened by the Go API middleware in apps/backend/api/
# security_headers.go, and double-emission (two CSP / two HSTS headers) would
# otherwise occur. See refs/plan/operations/security.md.
#
# This response header is the single authoritative CSP: index.html
# intentionally has no CSP <meta> tag (browsers enforce the intersection of
# all policies, which would make deploy-time adjustments impossible).
#
# This file is an nginx envsubst template. The official nginx image entrypoint
# renders it at container startup to /etc/nginx/snippets/security-headers.conf
# (see NGINX_ENVSUBST_OUTPUT_DIR in apps/frontend/Dockerfile), substituting
# ONLY the two ${ALGA_CSP_*} placeholders below; nginx runtime variables such
# as $strict_transport_security are left untouched because envsubst is invoked
# with an explicit variable allow-list. Both env vars default to "" in the
# Dockerfile, which renders the strict baseline policy. Deployments fronted by
# a CDN that injects scripts (e.g. Cloudflare Web Analytics) append sources by
# setting the env vars — space-separated CSP source expressions:
#   ALGA_CSP_SCRIPT_SRC_EXTRA="https://static.cloudflareinsights.com"
#   ALGA_CSP_CONNECT_SRC_EXTRA="https://cloudflareinsights.com"

# X-Content-Type-Options: block MIME sniffing (ASVS V12.4 / Gresto 32.29).
add_header X-Content-Type-Options "nosniff" always;

# X-Frame-Options: legacy clickjacking defense (CSP frame-ancestors is the
# modern control and is set below).
add_header X-Frame-Options "SAMEORIGIN" always;

# Referrer-Policy: limit leakage of the URL to cross-origin destinations
# (ASVS V12.4 / Gresto 32.29).
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# Permissions-Policy: disable every browser feature the SPA does not use. The
# incident-management UI needs none of the camera/mic/geo/location/USB/payment
# surfaces, so they are all switched off (Gresto 32.29).
add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()" always;

# Content-Security-Policy (strict, SPA-aware). Rationale:
#   - default-src 'self': nothing loads unless explicitly allowed.
#   - script-src 'self': Vite bundles all JS into /assets/*.js (module
#     scripts); no inline scripts are used, so 'unsafe-inline' is NOT granted.
#   - style-src 'self' 'unsafe-inline' https://fonts.googleapis.com: Tailwind
#     and Vue scoped styles inject inline <style>, and the UI dynamically
#     appends <link rel="stylesheet"> to fonts.googleapis.com (see
#     src/lib/font.ts), which is gated by style-src.
#   - font-src 'self' https://fonts.gstatic.com data:: webfont files come from
#     gstatic; data: covers any inlined font.
#   - img-src 'self' data: blob:: markdown/DOMPurify rendering and avatars may
#     use data:/blob: images.
#   - connect-src 'self': API + SSE (/api/v1/events) are same-origin.
#   - object-src 'none': no <object>/<embed>/<applet> plugins.
#   - frame-ancestors 'none': no framing (clickjacking).
#   - ALGA_CSP_SCRIPT_SRC_EXTRA / ALGA_CSP_CONNECT_SRC_EXTRA: deploy-time
#     additions (see header comment); empty by default, and an empty expansion
#     is harmless because CSP source lists are whitespace-separated.
# Tiptap/ProseMirror rendering is XSS-sensitive, but it operates on the DOM
# client-side and is sanitized by DOMPurify (src/components/ui/MarkdownRenderer
# .vue); CSP is defense-in-depth, DOMPurify remains the primary control.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${ALGA_CSP_SCRIPT_SRC_EXTRA}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' ${ALGA_CSP_CONNECT_SRC_EXTRA}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

# HSTS: emit only when the request arrived over TLS, including via a trusted
# reverse proxy that sets X-Forwarded-Proto (the container itself listens on
# :80; TLS terminates at the LB). Never emit over plain HTTP. The API responses
# carry their own HSTS from the Go middleware, so this covers the SPA document.
# preload is included for public deployments; submission to the HSTS preload
# list is a separate manual step.
#
# The value comes from the http-scope `map` in hsts-map.conf (empty unless
# X-Forwarded-Proto is "https"). A `map` is used instead of an `if` block
# because `if` + `add_header` makes nginx drop every sibling `add_header` in
# this file when the condition matches, and `if` is not valid at http scope.
add_header Strict-Transport-Security $strict_transport_security always;
