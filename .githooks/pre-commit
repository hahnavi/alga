#!/usr/bin/env bash
# Pre-commit gate: fast format + lint checks on staged files only.
#
# Slow checks (golangci-lint, full test suites) run in CI. This hook catches
# the common "forgot to format/lint" mistake locally in seconds.
#
# Activate after clone with:  git config core.hooksPath .githooks
# (also done automatically by the root `prepare` script on `pnpm install`)
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

staged_go=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' | grep -v '/ent/' || true)
staged_ts=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.vue' '*.js' '*.tsx' | grep '^apps/frontend/' | grep -v node_modules || true)
staged_int_ts=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.js' | grep '^integrations/' | grep -v node_modules | grep -v dist || true)
staged_md=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' | grep -v node_modules || true)

status=0

# ── Go: gofmt ──
if [[ -n "$staged_go" ]]; then
  unformatted=$(gofmt -l $staged_go)
  if [[ -n "$unformatted" ]]; then
    echo "✖ gofmt: these Go files need formatting:"
    echo "$unformatted"
    echo "  Fix: gofmt -w $unformatted"
    status=1
  fi
fi

# ── Frontend: oxlint + oxfmt ──
if [[ -n "$staged_ts" ]]; then
  cd "$repo_root/apps/frontend"

  # Strip the apps/frontend/ prefix so paths resolve from the workspace root.
  local_ts=""
  for f in $staged_ts; do
    local_ts+=" ${f#apps/frontend/}"
  done

  # oxlint
  if pnpm exec oxlint $local_ts >/tmp/precommit-oxlint.log 2>&1; then
    :
  else
    echo "✖ oxlint: lint errors in staged frontend files"
    cat /tmp/precommit-oxlint.log
    echo "  Fix: pnpm --filter frontend lint --fix"
    status=1
  fi

  # oxfmt (check only)
  if pnpm exec oxfmt --check $local_ts >/tmp/precommit-oxfmt.log 2>&1; then
    :
  else
    echo "✖ oxfmt: these frontend files need formatting:"
    cat /tmp/precommit-oxfmt.log
    echo "  Fix: pnpm --filter frontend exec oxfmt $local_ts"
    status=1
  fi

  cd "$repo_root"
fi

# ── Integrations: oxlint + oxfmt ──
if [[ -n "$staged_int_ts" ]]; then
  cd "$repo_root"

  if pnpm exec oxlint $staged_int_ts >/tmp/precommit-oxlint-int.log 2>&1; then
    :
  else
    echo "✖ oxlint: lint errors in staged integration files"
    cat /tmp/precommit-oxlint-int.log
    echo "  Fix: pnpm exec oxlint --fix $staged_int_ts"
    status=1
  fi

  if pnpm exec oxfmt --check $staged_int_ts >/tmp/precommit-oxfmt-int.log 2>&1; then
    :
  else
    echo "✖ oxfmt: these integration files need formatting:"
    cat /tmp/precommit-oxfmt-int.log
    echo "  Fix: pnpm exec oxfmt $staged_int_ts"
    status=1
  fi
fi

# ── Markdown: markdownlint + oxfmt ──
if [[ -n "$staged_md" ]]; then
  cd "$repo_root"

  if pnpm exec markdownlint-cli2 $staged_md >/tmp/precommit-mdlint.log 2>&1; then
    :
  else
    echo "✖ markdownlint: issues in staged markdown files"
    cat /tmp/precommit-mdlint.log
    echo "  Fix: pnpm exec markdownlint-cli2 --fix $staged_md"
    status=1
  fi

  if pnpm exec oxfmt --check $staged_md >/tmp/precommit-oxfmt-md.log 2>&1; then
    :
  else
    echo "✖ oxfmt: these markdown files need formatting:"
    cat /tmp/precommit-oxfmt-md.log
    echo "  Fix: pnpm --filter frontend exec oxfmt $staged_md"
    status=1
  fi
fi

# ── Secret scan: betterleaks on the staged diff ──
# CI runs the full-history scan; this catches secrets before they land in a
# commit at all. .betterleaks.toml at the repo root is picked up automatically.
if command -v betterleaks >/dev/null 2>&1; then
  if ! betterleaks git "$repo_root" --pre-commit --staged >/tmp/precommit-betterleaks.log 2>&1; then
    echo "✖ betterleaks: secrets detected in staged changes"
    cat /tmp/precommit-betterleaks.log
    echo "  If these are fixtures/placeholders, extend the prefilter in .betterleaks.toml"
    status=1
  fi
else
  echo "ℹ betterleaks not installed, skipping staged secret scan (CI still enforces it)"
fi

if [[ $status -ne 0 ]]; then
  exit 1
fi

echo "✔ pre-commit checks passed"
