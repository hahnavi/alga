# ── Docker Compose ─────────────────────────────────────────────────────────────
# These variables are used by docker-compose.yml for infrastructure services.
# Backend and frontend app config lives in their respective .env.example files:
#   - apps/backend/.env.example
#   - apps/frontend/.env.example

# Image version — pin to a release tag (e.g. v1.2.3) or leave as latest.
ALGA_VERSION=latest

# WARNING: Change these defaults for any non-local deployment!
POSTGRES_USER=alga
POSTGRES_PASS=alga_dev_only
POSTGRES_DB=alga
VALKEY_PASSWORD=valkey_dev_only
RABBITMQ_USER=alga
RABBITMQ_PASS=alga_dev_only

# ── Backend HTTP server hardening (V12.1) ─────────────────────────────────────
# All have safe defaults; override only to tune for your deployment.
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_IDLE_TIMEOUT=120s
# SERVER_MAX_HEADER_BYTES=1048576


# ── Legacy query-token auth (optional escape hatches, deny by default) ────────
# Credentials in URLs leak via proxy/access logs, Referer headers and browser
# history. Both flags re-enable the legacy `?token=` authentication and are
# slated for removal one minor release after introduction; a loud warning is
# logged at startup when either is true.
# WEBHOOK_ALLOW_QUERY_TOKEN=true accepts ?token= on POST /webhooks/alerts
#   (Grafana/Alertmanager senders should migrate to the Authorization header).
WEBHOOK_ALLOW_QUERY_TOKEN=false
# AGENT_SSE_ALLOW_QUERY_TOKEN=true accepts ?token= on GET /api/v1/agent/events
#   for pure-EventSource consumers; prefer fetch()-based SSE with a Bearer
#   header (all bundled SDKs already use headers).
AGENT_SSE_ALLOW_QUERY_TOKEN=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-minute fixed-window ceilings, applied identically by the memory and
# Valkey limiter backends. Raise GENERAL if a legitimate source (e.g. a busy
# Grafana) posts more than 20 webhook requests per minute from one IP.
RATE_LIMIT_GENERAL_PER_MINUTE=20
RATE_LIMIT_AGENT_PER_MINUTE=120
# Comma-separated trusted proxy IPs/CIDRs (e.g. `10.0.0.0/8,192.168.1.7`).
# Required when Alga sits behind a load balancer/reverse proxy so rate
# limiting keys on the real client IP (rightmost untrusted X-Forwarded-For
# entry). Leave empty when directly exposed: spoofed X-Forwarded-For headers
# are then ignored entirely.
#TRUSTED_PROXIES=
