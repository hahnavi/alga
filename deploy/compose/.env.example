# Alga deployment configuration.
# Copy to .env next to docker-compose.yml and fill in every required value.

# ── Image version ─────────────────────────────────────────────────────────────
# Any published tag of ghcr.io/hahnavi/alga-{backend,frontend}.
ALGA_VERSION=latest

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Host port serving the UI (nginx proxies /api and /webhooks to the backend).
ALGA_HTTP_PORT=3000
# Set to true only when serving behind HTTPS (TLS-terminating reverse proxy).
SECURE_COOKIES=false

# ── Infrastructure credentials (REQUIRED) ─────────────────────────────────────
POSTGRES_USER=alga
POSTGRES_PASS=
POSTGRES_DB=alga
VALKEY_PASSWORD=
RABBITMQ_USER=alga
RABBITMQ_PASS=

# ── Backend crypto (REQUIRED — startup fails without these) ───────────────────
# ENCRYPTION_KEYS is a comma-separated list of `kid:base64(32-byte key)` pairs.
# Generate: echo "1:$(openssl rand -base64 32)"
ENCRYPTION_KEYS=
# Generate: openssl rand -base64 32
SECRET_PEPPER=

# ── Optional tuning ───────────────────────────────────────────────────────────
# LOG_LEVEL=info
# ENVIRONMENT=production
# SESSION_EXPIRY_HOURS=24
