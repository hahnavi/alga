# Alga Agent — Example Configuration
#
# Copy to config.yaml and edit, or supply values via environment variables
# (env vars always override YAML values). Path can be overridden with
# ALGA_AGENT_CONFIG=/path/to/config.yaml.

# Agent identity (used in the system prompt).
agent:
  name: "Alga Agent"
  description: "SRE assistant for the Alga platform"

# LLM configuration. Works with any OpenAI-compatible endpoint.
model:
  # Providers: openrouter | openai | opencode-zen | opencode-go | zai |
  # zai-coding-plan | alibaba | alibaba-coding-plan | custom.
  # Base URL is filled from the provider automatically when omitted.
  provider: openrouter
  base_url: https://openrouter.ai/api/v1
  api_key: ${OPENROUTER_API_KEY}   # get one at https://openrouter.ai/keys
  model: openrouter/free
  max_tokens: 4096
  temperature: 0.3

# Alga channel (backend investigation threads).
alga:
  enabled: false
  server_url: ${ALGA_SERVER_URL}
  agent_token: ${ALGA_AGENT_TOKEN}

# Tools available to the agent.
tools:
  # Persistent terminal — full shell session for deep investigation.
  # Supports arbitrary commands, pipes, redirects, persistent cwd.
  # Replaces the legacy whitelisted shell when enabled.
  # Disabled by default: it grants arbitrary command execution. Opt in only
  # when the agent runs under a least-privilege user/container.
  terminal:
    enabled: false
    cwd: ""                    # initial working directory; empty = process cwd
    max_output_bytes: 65536    # truncate output beyond this
    timeout: 120s              # per-command timeout

  # Legacy whitelisted shell (only used when terminal is disabled).
  shell:
    enabled: false
    allowed_commands:
      - ls
      - cat
      - grep
      - head
      - tail
      - wc
      - curl
      - dig
      - ping
      - ps
      - top
    max_output_bytes: 10240
    timeout: 30s

  # File manipulation tools: read_file, write_file, search_files, patch.
  # Disabled by default. When enabled, roots MUST list explicitly scoped
  # directory trees — an empty list fails validation. Avoid ["/"]; scope to a
  # dedicated workspace instead.
  file_tools:
    enabled: false
    roots:                     # allowed directory trees; scope to a workspace, not "/"
      - /home/alga/workspace
    max_read_bytes: 262144     # max bytes returned per read_file call

  web_search:
    enabled: true
    provider: duckduckgo     # duckduckgo | brave | tavily
    api_key: ${SEARCH_API_KEY}   # required for brave/tavily; ignored for duckduckgo
    max_results: 5
    fetch_content: false

  # Fetch and extract readable content from URLs (complements web_search).
  web_extract:
    enabled: true
    max_chars: 50000           # max characters per extracted page

# Agent behavior.
agent_behavior:
  max_iterations: 30         # max LLM round-trips per message
  tool_timeout: 30s          # per-tool execution timeout
  context_window: 20         # max messages retained per session
  system_prompt_file: ""     # optional: path to custom base prompt

# Session memory persistence. Conversations are saved as JSON files after
# each turn and reloaded after restarts or idle eviction.
sessions:
  persist: true              # false = in-memory only (lost on restart)
  dir: ""                    # empty = <data dir>/sessions (~/.alga/sessions)
  retention_days: 0          # delete session files older than N days; 0 = keep forever

# Logging. Logs always go to stderr; by default they are also written to a
# size-rotated file under the data dir.
logging:
  level: info                # debug | info | warn | error
  file: ""                   # empty = <data dir>/logs/agent.log; "stderr" = no file
  max_size_mb: 5             # rotate when the file exceeds this size
  backup_count: 3            # rotated files kept

# Optional Prometheus metrics endpoint.
metrics:
  enabled: false
  addr: "127.0.0.1:9101"

# Model Context Protocol (MCP) integration.
#
# The agent plays two MCP roles:
#
#   server:   exposes the agent's tools (alga_*, terminal, file, web_search,
#             web_extract, todo) to external MCP clients — Claude Desktop,
#             Cursor, custom automation. Point your MCP client at
#             http://<addr><path> to list and call tools through the standard
#             MCP Streamable HTTP transport.
#
#   clients:  imports tools from external MCP servers (filesystem browsers,
#             GitHub clients, database inspectors, in-house tools). Each
#             server's tools are surfaced under a namespaced name
#             ("<name>_<tool>") to avoid collisions with Alga tools.
mcp:
  server:
    enabled: false
    addr: "127.0.0.1:8085"
    path: "/mcp"
  clients: []
    # Stdio transport: spawn a subprocess that speaks MCP over stdin/stdout.
    # - name: filesystem
    #   command: npx
    #   args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    #   init_timeout: 15s
    #
    # HTTP transport: connect to a Streamable HTTP MCP server.
    # - name: github
    #   url: https://mcp.github.example.com/mcp
    #   init_timeout: 10s
    #
    # Disable a server without removing its config:
    # - name: legacy
    #   url: https://legacy-mcp.example.com/mcp
    #   disabled: true
