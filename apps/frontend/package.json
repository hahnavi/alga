{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "E2E_INTEGRATION=1 playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-mention": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/suggestion": "^3.27.3",
    "@tiptap/vue-3": "^3.24.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.11",
    "markdown-it": "^14.2.0",
    "pinia": "^4.0.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.1",
    "oxfmt": "^0.61.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
